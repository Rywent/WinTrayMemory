<UserControl x:Class="WinTrayMemory.MainPage.Components.Actions.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinTrayMemory.MainPage.Components.Actions"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WinTrayMemory;component/Resources/Styles/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Button Background="#155DFC" Height="30" Grid.Column="0" 
                Content="SMART CLEAN" FontSize="11" Foreground="White" FontWeight="Medium"
                BorderBrush="#1447E6" BorderThickness="1" Style="{StaticResource ActionButtonStyle}"
                Command="{Binding SmartCleaningCommand}"/>
        <ToggleButton Margin="10 0 0 0" 
              Height="30" 
              Grid.Column="1"
              Style="{StaticResource ButtonAutoMode}"
              IsChecked="{Binding IsAuto}"
              Content="{Binding AutoModeText}"
              FontSize="11" 
              Foreground="White" 
              FontWeight="Medium"/>
    </Grid>
</UserControl>
