<UserControl x:Class="WinTrayMemory.MainPage.MainPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinTrayMemory.MainPage"
             xmlns:header="clr-namespace:WinTrayMemory.MainPage.Components.Header"
             xmlns:memoryUsage="clr-namespace:WinTrayMemory.MainPage.Components.MemoryUsage"
             xmlns:heaviestProcesses="clr-namespace:WinTrayMemory.MainPage.Components.HeaviestProcesses"
             xmlns:actions="clr-namespace:WinTrayMemory.MainPage.Components.Actions"
             xmlns:memoryRamHistoryChart="clr-namespace:WinTrayMemory.MainPage.Components.RamHistoryChart"     
             xmlns:memoryDetailingChart="clr-namespace:WinTrayMemory.MainPage.Components.MemoryDetailingChart"
             xmlns:memoryPressure="clr-namespace:WinTrayMemory.MainPage.Components.MemoryPressure"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WinTrayMemory;component/Resources/Styles/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <header:HeaderView DataContext="{Binding Header}" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" 
                      Style="{StaticResource CustomScroll}"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <memoryUsage:MemoryUsageView DataContext="{Binding Memory}" Margin="10 10 0 0"/>
                <memoryRamHistoryChart:RamHistoryChartView DataContext="{Binding RamHistoryChart}" Margin="10 5 0 0" Height="150"/>
                <memoryDetailingChart:MemoryDetailingChartView DataContext="{Binding MemoryDetailingChart}" Margin="10 5 0 0" Height="150"/>
                <memoryPressure:MemoryPressureView DataContext="{Binding MemoryPressure}" Margin="10 5 0 0" Height="150"/>
                <actions:ActionsView DataContext="{Binding Actions}" Margin="10 15 0 0"/>
                <heaviestProcesses:HeaviestProcessesView DataContext="{Binding HeaviestProcesses}" Margin="10 5 0 10"/>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 15" HorizontalAlignment="Center">
                    <Image Source="/Resources/img/avatar.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                    <TextBlock FontSize="11" HorizontalAlignment="Center" Text="{Binding VersionText}"
                               Cursor="Hand" MouseLeftButtonDown="OpenGitHub"
                               Foreground="#45556C" Margin="5 0 0 0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
