<UserControl x:Class="WinTrayMemory.SettingsPage.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:header="clr-namespace:WinTrayMemory.SettingsPage.Components.Header"
             xmlns:processMonitoring="clr-namespace:WinTrayMemory.SettingsPage.Components.ProcessMonitoring"
             xmlns:autoClean="clr-namespace:WinTrayMemory.SettingsPage.Components.AutoClean"
             xmlns:smartCleaningOptions="clr-namespace:WinTrayMemory.SettingsPage.Components.SmartCleaningOptions"
             xmlns:general="clr-namespace:WinTrayMemory.SettingsPage.Components.General"
             xmlns:processCategories="clr-namespace:WinTrayMemory.SettingsPage.Components.ProcessCategories"
             xmlns:local="clr-namespace:WinTrayMemory.SettingsPage"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WinTrayMemory;component/Resources/Styles/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <header:HeaderView DataContext="{Binding Header}" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" 
                      Style="{StaticResource CustomScroll}"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander Header="PROCESS MONITORING"
                          Style="{StaticResource ModernExpander}" Margin="10 10 0 0">
                    <processMonitoring:ProcessMonitoringView DataContext="{Binding ProcessMonitoring}"/>
                </Expander> 
                <Expander Header="AUTO CLEAN" 
                         Style="{StaticResource ModernExpander}" Margin="10 0 0 0">
                    <autoClean:AutoCleanView DataContext="{Binding AutoClean}"/>
                </Expander>
                <Expander Header="SMART CLEANING OPTIONS" 
                        Style="{StaticResource ModernExpander}" Margin="10 0 0 0">
                    <smartCleaningOptions:SmartCleaningOptionsView DataContext="{Binding SmartCleaningOptions}"/>
                </Expander>
                <Expander Header="PROCESS CATEGORIES" 
                        Style="{StaticResource ModernExpander}" Margin="10 0 0 0">
                    <processCategories:ProcessCategoriesView DataContext="{Binding ProcessCategoreies}"/>
                </Expander>
                <Expander Header="GENERAL" 
                        Style="{StaticResource ModernExpander}" Margin="10 0 0 0">
                    <general:GeneralView DataContext="{Binding General}"/>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
